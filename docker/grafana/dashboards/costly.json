{
  "uid": "costly",
  "title": "AI Cost",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "timezone": "utc",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "title": "Total cost by project",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "description": "Estimated USD per project in the selected time range. Exact totals: costly report --by project.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (project) (increase(ai_cost_usd_total[$__range])))",
          "instant": true,
          "legendFormat": "{{project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "title": "Top 5 users in $top_project",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "description": "The 5 users who spent the most in this project in the selected time range. Pick projects in \"Top users for\" at the top.",
      "repeat": "top_project",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(topk(5, sum by (user) (increase(ai_cost_usd_total{project=\"$top_project\"}[$__range]))))",
          "instant": true,
          "legendFormat": "{{user}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 1,
      "title": "Estimated USD in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_cost_usd_total[$__range]))",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Cost by project",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project) (increase(ai_cost_usd_total[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Cost by user",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user) (increase(ai_cost_usd_total[$__range]))",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Cost by model",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(ai_cost_usd_total[$__range]))",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Cost by tool",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (increase(ai_cost_usd_total[$__range]))",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Tokens by type",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (increase(ai_tokens_total[$__range]))",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Cache read share",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_tokens_total{token_type=\"cache_read\"}[$__range])) / clamp_min(sum(increase(ai_tokens_total{token_type=~\"input|cache_read|cache_write|cache_write_1h\"}[$__range])), 1)",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Cost by project and user",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project,user) (increase(ai_cost_usd_total[$__range]))",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Unassigned request share",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "costly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_requests_total{project=\"unassigned\"}[$__range])) / clamp_min(sum(increase(ai_requests_total[$__range])), 1)",
          "instant": true,
          "legendFormat": "{{project}}{{user}}{{model}}{{tool}}{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "top_project",
        "label": "Top users for",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "costly-prometheus"
        },
        "query": {
          "query": "label_values(ai_cost_usd_total, project)",
          "refId": "top_project"
        },
        "definition": "label_values(ai_cost_usd_total, project)",
        "multi": true,
        "includeAll": false,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": [
            "milo",
            "sirco"
          ],
          "value": [
            "milo",
            "sirco"
          ]
        }
      }
    ]
  }
}
